# Machine Selection
MACHINE ??= "raspberrypi3-64"

# Serial console on the Pi 3's GPIO14/15 UART (header pins 8/10), 115200 8N1.
# Without enable_uart=1 the Pi 3 mini-UART's baud drifts with the core clock and
# you get pure garbage on the wire -- this pins it so a serial console (e.g. the
# ESP32 bridge in tools/esp32-serial-bridge/) is actually readable. Cheap
# insurance for a headless image you may need to debug when networking doesn't
# come up. (The RAUC build in build-rauc/ sets this too.)
ENABLE_UART = "1"

# Reference distro policy - see docs/first-build.md for why we're not rolling
# our own DISTRO yet.
DISTRO ?= "poky"

PACKAGE_CLASSES ?= "package_ipk"

USER_CLASSES ?= "buildstats"

PATCHRESOLVE = "noop"

# EXTRA_IMAGE_FEATURES is the local.conf-level way to add IMAGE_FEATURES to
# whatever image you build. schultz-image-minimal.bb already sets
# IMAGE_FEATURES directly instead (so the image is reproducible regardless of
# local.conf), but this is the more common place to do it if you build other
# images from this same config:
#EXTRA_IMAGE_FEATURES ?= "debug-tweaks"

# Disk space/inode monitoring: abort tasks instead of silently filling the
# disk. Values are the conservative defaults from the stock Poky local.conf.
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

CONF_VERSION = "2"

# --- Tuning for a memory-constrained build host (e.g. 8GB RAM) ---
# Uncomment and adjust if dmesg shows the OOM killer taking out build tasks.
# Lower numbers are slower but much less likely to run out of memory.
#BB_NUMBER_THREADS = "2"
#PARALLEL_MAKE = "-j 2"

# Non-free RPi firmware (Wi-Fi/Bluetooth/VideoCore) needs an explicit
# LICENSE_FLAGS_ACCEPTED entry -- BitBake's own error message will tell you
# the exact flag name(s) to add here if/when it complains. See
# docs/first-build.md.
#LICENSE_FLAGS_ACCEPTED = ""

# --- Activated 2026-07-03: Nexus Repository CE as a shared sstate/source mirror ---
# Corrected from an earlier "Artifactory" version of this comment -- checked
# the actual home-lab infra (the-docker-swarm-ai project) and there is no
# Artifactory instance. It was deliberately evaluated and rejected there
# (free tier is Java-only, no npm; download infra points at the dead
# Bintray) in favor of Nexus Repository CE, which IS actually running
# (MacStudioM2Max12:8081, this same Mac). Nexus didn't have a generic "raw"
# repo before this (only maven-public/npm-proxy/docker-proxy) -- created
# yocto-sources-raw + yocto-sstate-raw via scripts/setup-nexus-mirror.sh,
# and verified an actual PUT-from-Mac / GET-from-build-host round trip works
# (anonymous read, same posture as the other Nexus repos on this instance).
SSTATE_MIRRORS ?= "file://.* http://MacStudioM2Max12.local:8081/repository/yocto-sstate-raw/PATH;downloadfilename=PATH"
SOURCE_MIRROR_URL ?= "http://MacStudioM2Max12.local:8081/repository/yocto-sources-raw/"
INHERIT += "own-mirrors"

# --- Optional: sign the IPK package feed ---
# Run scripts/generate-signing-keys.sh first (creates the "schultz-dev" GPG
# key). This signs the feed/repository index, not individual .ipk files --
# that's the mechanism IPK actually has (RPM has real per-package signing
# instead, via a different class -- see docs/yocto-concepts.md).
INHERIT += "sign_package_feed"
PACKAGE_FEED_GPG_NAME = "schultz-dev"
PACKAGE_FEED_GPG_PASSPHRASE_FILE = "${TOPDIR}/../keys/gpg-passphrase.txt"

# --- Optional: RAUC (signed, A/B-capable OTA updates) ---
# Real scope note: this enables RAUC and lets you build a signed bundle, but
# safe A/B rollback also needs a bootloader (U-Boot) + partition layout
# change that isn't wired up here yet -- see docs/yocto-concepts.md for
# exactly what's scaffolded vs. what still needs physical hardware bring-up.
DISTRO_FEATURES:append = " rauc"
IMAGE_INSTALL:append = " rauc rauc-conf"

# --- Activated 2026-07-03: cve-check ---
# Scans package versions against a local NVD feed mirror at build time (in
# addition to, not instead of, Dependency-Track's continuous post-build
# re-analysis -- see docs/yocto-concepts.md). Report per image:
# tmp/deploy/images/<machine>/<image>.rootfs.cve
INHERIT += "cve-check"

# --- Optional: attack-surface hardening (opt-in; everything below is OFF) ---
# The "controlled, config-driven" way to decide what a given image can even do
# is native Yocto vars -- no custom tooling needed. Uncomment a knob and that
# capability is gone from THAT signed A/B release (and auditable in its
# PROVENANCE.txt). Full "four layers" writeup in docs/yocto-concepts.md.
#
# 1. Drop debug-tweaks (empty root password + passwordless SSH) -- the single
#    highest-value change for a locked-down build. It's set in the image
#    recipe; remove it globally from here:
#IMAGE_FEATURES:remove = "debug-tweaks"
#
# 2. Immutable running rootfs:
#IMAGE_FEATURES:append = " read-only-rootfs"
#
# 3. Compile OUT the Bluetooth + Wi-Fi stacks (no BlueZ / wpa-supplicant built
#    anywhere). To also power the radios down in firmware, add the disable-bt /
#    disable-wifi overlays to config.txt.
#DISTRO_FEATURES:remove = "bluetooth wifi"
#
# 4. USB mass storage -- WARNING: on the Pi 3 the Ethernet NIC is itself a USB
#    device, so never disable USB host wholesale (it kills eth0 -> SSH -> OTA).
#    Dropping just the mass-storage driver is safe, but needs a kernel .cfg
#    fragment via a linux-raspberrypi bbappend (not a local.conf one-liner):
#      recipes-kernel/linux/linux-raspberrypi_%.bbappend:
#        FILESEXTRAPATHS:prepend := "${THISDIR}/files:"
#        SRC_URI += "file://no-usb-storage.cfg"
#      files/no-usb-storage.cfg:
#        # CONFIG_USB_STORAGE is not set
